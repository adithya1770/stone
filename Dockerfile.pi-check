FROM --platform=linux/arm64 python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libjpeg62-turbo \
    libopenblas0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

CMD ["python3", "-c", "\
from runtime.inference_engine import InferenceEngine; \
from runtime.telemetry import get_telemetry; \
from runtime.reward import calculate_reward; \
from runtime.decision_engine import get_algo; \
print('--- Imports OK ---'); \
engine = InferenceEngine( \
    fp32_path='models/mobilenet_v2_fp32.tflite', \
    int8_path='models/mobilenet_v2_int8.tflite', \
    labels_path='models/labels.txt' \
); \
print('--- Engine loaded OK ---'); \
result = engine.run('dog.jpeg', 'fp32'); \
print('--- Inference OK:', result, '---'); \
t = get_telemetry(); \
print('--- Telemetry OK:', t, '---'); \
r = calculate_reward(0.5467, 13, cpu=10, ram=40, temperature=45, decision_time_ms=0.15); \
print('--- Reward OK:', r, '---'); \
algo = get_algo('linucb', alpha=1.0); \
chosen, scores = algo.choose(cpu=20, ram=40, temp=50, battery=100); \
print('--- Decision engine OK:', chosen, scores, '---'); \
print('=== ALL CHECKS PASSED ==='); \
"]